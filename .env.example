# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.

# Hunar Voice Agents API key (from the assignment email). Backend-only.
HUNAR_API_KEY=

# Populated by running: python scripts/setup_agents.py
# (creates the two Hunar agents used by this app and prints these IDs)
HIRING_AGENT_ID=
REACHOUT_AGENT_ID=

# Apollo.io API key (Settings -> Integrations -> API Keys). Backend-only.
# Used ONLY for People Search (api/_apollo.py) -- never for calling.
APOLLO_API_KEY=
